# Port server (Render tự động cấp PORT)
PORT=3000

# URL công khai của server này (VD: https://trotot-payment.onrender.com)
SERVER_BASE_URL=https://trotot-payment.onrender.com

# URL web app Flutter
APP_BASE_URL=https://phongtro-ai.web.app

# Firebase Service Account JSON (dán nguyên nội dung file JSON thành 1 dòng)
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"phongtro-ai",...}

# Cấu hình MoMo (Mặc định dùng Sandbox nếu không set MOMO_ENVIRONMENT=production)
MOMO_ENVIRONMENT=sandbox

# Google Gemini API Key (giữ hoàn toàn phía server để không lộ trên client)
GEMINI_API_KEY=your_gemini_api_key_here
