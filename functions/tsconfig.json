    "noUnusedLocals": true,
    "outDir": "lib",
    "rootDir": "..",
    "sourceMap": true,
    "strict": true,
    "target": "es2021"
  },
  "compileOnSave": true,
  "include": [
    "src/**/*",
    "../backend-shared/**/*"
  ]
}

